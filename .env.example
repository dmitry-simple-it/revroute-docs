REVROUTE_API_URL=http://localhost:8888/api
# REVROUTE_API_URL=https://api.revroute.ru/
REVROUTE_SHORT_LINKER_API_KEY=
NEXT_PUBLIC_YANDEX_METRIKA_ID=
REVROUTE_WORKSPACE_ID=
REVROUTE_PUBLIC_DOMAIN=

# Лид-формы (/packaging, /audit, /prm, /partner-channel): заявки уходят в Telegram через Bot API.
# Токен бота — от @BotFather; chat_id — ваш личный или id группы (узнать: @userinfobot).
# ВНИМАНИЕ: chat_id — это id ПОЛУЧАТЕЛЯ, а не бота. Id бота (первое число токена) сюда не подходит:
# заявки будут молча уходить в никуда.
# Пока не заданы — форма показывает фолбэк «напишите в Telegram», заявки дублируются в docker logs.
TELEGRAM_LEAD_BOT_TOKEN=
TELEGRAM_LEAD_CHAT_ID=

# С прод-сервера (РФ) api.telegram.org недоступен, поэтому запрос идёт через nginx-прокси
# на ноде вне РФ — ту же, через которую ходят вызовы LLM. Секрет уезжает в заголовке
# x-proxy-secret; прокси также пускает прод по IP. Локально прокси доступен через SSH-туннель:
#   ssh -N -L 18446:127.0.0.1:8446 root@<нода>   →   TELEGRAM_PROXY_URL=https://127.0.0.1:18446
TELEGRAM_PROXY_URL=
TELEGRAM_PROXY_SECRET=